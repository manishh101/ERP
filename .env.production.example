# Production Environment Configuration — TEMPLATE
# Copy this file to .env.production and fill in real values.
# NEVER commit .env.production to version control.

NODE_ENV=production
PORT=4000

# Database — Use a strong, unique password
DATABASE_URL=postgresql://postgres:YOUR_STRONG_PASSWORD@db:5432/furniture_erp

# JWT — Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_64_BYTE_HEX_SECRET
JWT_EXPIRES_IN=8h

# CORS — Your production domain
CORS_ORIGIN=https://yourdomain.com

# Redis — Include password if configured
REDIS_URL=redis://:YOUR_REDIS_PASSWORD@redis:6379

# Client
VITE_API_URL=/api
VITE_GOOGLE_CLIENT_ID=673329330321-dmtusl0jsm341cegbsv4nf58a7ptf187.apps.googleusercontent.com

# Google Sign-In
GOOGLE_CLIENT_ID=673329330321-dmtusl0jsm341cegbsv4nf58a7ptf187.apps.googleusercontent.com
