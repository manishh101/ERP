model InvoiceTemplate {
  id           String   @id @default(cuid())
  tenantId     String   @unique @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  primaryColor String   @default("#7c5c45") @map("primary_color")
  footerText   String   @default("Thank you for your business.") @map("footer_text")
  paymentTerms String   @default("Payment due within 14 days.") @map("payment_terms")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("invoice_templates")
}

model BankStatementImport {
  id             String              @id @default(cuid())
  tenantId       String              @map("tenant_id")
  tenant         Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fileName       String              @map("file_name")
  importedAt     DateTime            @default(now()) @map("imported_at")
  totalLines     Int                 @default(0) @map("total_lines")
  unmatchedLines Int                 @default(0) @map("unmatched_lines")
  lines          BankStatementLine[]

  @@map("bank_statement_imports")
}

model BankStatementLine {
  id                  String              @id @default(cuid())
  tenantId            String              @map("tenant_id")
  tenant              Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  importId            String              @map("import_id")
  matchedPaymentId    String?             @map("matched_payment_id")
  transactionDate     DateTime            @map("transaction_date")
  description         String
  reference           String?
  amount              Decimal             @db.Decimal(14, 2)
  isMatched           Boolean             @default(false) @map("is_matched")
  bankStatementImport BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedPayment      Payment?            @relation(fields: [matchedPaymentId], references: [id], onDelete: SetNull)

  @@index([importId, isMatched])
  @@map("bank_statement_lines")
}

model User {
  id                    String          @id @default(cuid())
  tenantId              String          @map("tenant_id")
  tenant                Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name                  String
  email                 String          @unique
  passwordHash          String?         @map("password_hash")
  googleId              String?         @unique @map("google_id")
  role                  UserRole
  isActive              Boolean         @default(true) @map("is_active")
  createdAt             DateTime        @default(now()) @map("created_at")
  updatedAt             DateTime        @updatedAt @map("updated_at")
  createdPurchaseOrders PurchaseOrder[]
  salesOrders           SalesOrder[]
  journalEntries        JournalEntry[]
  deliveries            Delivery[]
  stockMovements        StockMovement[]
  goodsReceipts         GoodsReceipt[]
  auditLogs             AuditLog[]

  @@map("users")
}

model ArLedger {
  id             String   @id @default(cuid())
  tenantId       String   @map("tenant_id")
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerId     String   @map("customer_id")
  salesOrderId   String   @map("sales_order_id")
  paymentId      String?  @map("payment_id")
  entryType      String // "DEBIT" | "CREDIT"
  amount         Decimal  @db.Decimal(14, 2)
  runningBalance Decimal  @map("running_balance") @db.Decimal(14, 2)
  fiscalYear     String   @map("fiscal_year")
  bsDate         String   @map("bs_date")
  entryDate      DateTime @map("entry_date")
  narration      String?

  customer   Customer   @relation(fields: [customerId], references: [id])
  salesOrder SalesOrder @relation(fields: [salesOrderId], references: [id])
  payment    Payment?   @relation(fields: [paymentId], references: [id])

  @@index([customerId, fiscalYear, entryDate])
  @@index([tenantId, customerId, entryDate])
  @@map("ar_ledger")
}

model VatRegister {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  taxInvoiceId  String   @unique @map("tax_invoice_id")
  customerId    String   @map("customer_id")
  taxableAmount Decimal  @map("taxable_amount") @db.Decimal(14, 2)
  outputVat     Decimal  @map("output_vat") @db.Decimal(14, 2)
  totalWithVat  Decimal  @map("total_with_vat") @db.Decimal(14, 2)
  fiscalYear    String   @map("fiscal_year")
  bsDate        String   @map("bs_date")
  entryDate     DateTime @map("entry_date")

  taxInvoice TaxInvoice @relation(fields: [taxInvoiceId], references: [id])
  customer   Customer   @relation(fields: [customerId], references: [id])

  @@index([fiscalYear, bsDate])
  @@map("vat_register")
}

model InvoiceCounter {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear String @map("fiscal_year") // "2081/82"
  lastSeq    Int    @default(0) @map("last_seq")

  @@unique([fiscalYear, tenantId])
  @@map("invoice_counters")
}

model ReceiptCounter {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear String @map("fiscal_year") // "2081/82"
  lastSeq    Int    @default(0) @map("last_seq")

  @@unique([fiscalYear, tenantId])
  @@map("receipt_counters")
}

model AuditLog {
  id            String   @id @default(cuid())
  tenantId      String   @map("tenant_id")
  tenant        Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId        String   @map("user_id")
  action        String // e.g. CREATE_INVOICE | RECORD_PAYMENT | CREATE_SALES_ORDER | UPDATE_INVOICE
  entityType    String   @map("entity_type") // e.g. TaxInvoice | Payment | SalesOrder
  entityId      String   @map("entity_id")
  previousState Json?    @map("previous_state") // snapshot before mutation (null for creates)
  newState      Json?    @map("new_state") // snapshot after mutation (null for deletes)
  timestamp     DateTime @default(now())
  ipAddress     String?  @map("ip_address")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, timestamp])
  @@index([action, timestamp])
  @@map("audit_logs")
}

model EstimateCounter {
  id         String @id @default(cuid())
  tenantId   String @map("tenant_id")
  tenant     Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fiscalYear String @map("fiscal_year")
  lastSeq    Int    @default(0) @map("last_seq")

  @@unique([fiscalYear, tenantId])
  @@map("estimate_counters")
}
